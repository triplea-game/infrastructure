# Log to the host journald under a stable tag per service. The default
# json-file driver keeps only the current container's logs, so a redeploy or
# restart loses all history; journald persists on the host across container
# recreation, and the tag makes each service readable with `journalctl -t <tag>`
# (how pull-logs.sh reads them). Matches the forums role, also on journald.
services:
  service:
    image: {{ lobby_image }}
    ports:
      - "127.0.0.1:8010:8010"
    environment:
      - HTTP_PORT=8010
      - DB_URL=postgres18:5432/{{ database_name }}
      - DATABASE_USER={{ database_user }}
      - DATABASE_PASSWORD=${DB_PASSWORD}
      - SMTP_HOST=postfix
      - SMTP_PORT=25
      - SEND_EMAILS_ENABLED=true
      - EMAIL_FROM=no-reply@{{ lobby_mail_domain }}
    depends_on:
      postgres18:
        condition: service_healthy
      postfix:
        condition: service_started
    # Probes readiness with bash's /dev/tcp, which needs no curl or wget; the
    # eclipse-temurin JRE images ship neither. start_period is twice marti's
    # because the JVM starts slower and Flyway migrates before the app serves.
    # deploy-lobby.sh waits on this to decide rollback.
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8010 && printf 'GET /q/health/ready HTTP/1.0\\r\\n\\r\\n' >&3 && head -1 <&3 | grep -q ' 200 '"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 60s
    restart: unless-stopped
    logging:
      driver: journald
      options:
        tag: lobby
  postgres18:
    image: postgres:18
    environment:
      POSTGRES_USER: {{ database_user }}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: {{ database_name }}
    volumes:
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ database_user }} -d {{ database_name }}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    logging:
      driver: journald
      options:
        tag: lobby-postgres
  postfix:
    image: boky/postfix
    environment:
      - ALLOWED_SENDER_DOMAINS={{ lobby_mail_domain }}
      - POSTFIX_myhostname={{ lobby_mail_domain }}
      - DKIM_AUTOGENERATE=yes
    volumes:
      - dkim_keys:/etc/opendkim/keys
    restart: unless-stopped
    logging:
      driver: journald
      options:
        tag: lobby-postfix
volumes:
  pgdata:
  dkim_keys:
