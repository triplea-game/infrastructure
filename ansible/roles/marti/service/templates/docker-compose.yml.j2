# Cap the default json-file driver; without this these logs grow unbounded
# (unlike the forums host, which routes containers to the capped journald).
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  app:
    image: {{ marti_image }}
    # Runs as the host 'marti' account rather than the image's own 'appuser',
    # whose system uid is assigned inside the image and is not knowable from the
    # host; the mounted signing key is owner-only to marti.
    user: "{{ marti_uid }}:{{ marti_gid }}"
    ports:
      - "127.0.0.1:{{ marti_port }}:{{ marti_port }}"
    volumes:
      - ./config.json:/app/config.json:ro
      - ./keys:/app/keys:ro
    environment:
      - DB_PASSWORD=${DB_PASSWORD}
    depends_on:
      postgres:
        condition: service_healthy
      postfix:
        condition: service_started
    restart: unless-stopped
    logging: *default-logging
  postgres:
    image: postgres:16
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: dicedb
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    logging: *default-logging
  postfix:
    image: boky/postfix
    environment:
      - ALLOWED_SENDER_DOMAINS={{ marti_hostname }}
      - POSTFIX_myhostname={{ marti_hostname }}
      - DKIM_AUTOGENERATE=yes
    volumes:
      - dkim_keys:/etc/opendkim/keys
    restart: unless-stopped
    logging: *default-logging
volumes:
  pgdata:
  dkim_keys:
