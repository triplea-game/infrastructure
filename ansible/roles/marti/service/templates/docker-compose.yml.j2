# Log to the host journald under a stable tag per service. The default
# json-file driver keeps only the current container's logs, so a redeploy or
# restart loses all history; journald persists on the host across container
# recreation, and the tag makes each service readable with `journalctl -t <tag>`
# (how pull-logs.sh reads them). Matches the forums role, also on journald.
services:
  app:
    image: {{ marti_image }}
    # Runs as the host 'marti' account rather than the image's own 'appuser',
    # whose system uid is assigned inside the image and is not knowable from the
    # host; the mounted signing key is owner-only to marti.
    user: "{{ marti_uid }}:{{ marti_gid }}"
    # tini as PID 1 forwards SIGTERM; node as PID 1 ignores it, so a stop
    # would wait out the grace period and SIGKILL rolls in flight.
    init: true
    ports:
      - "127.0.0.1:{{ marti_port }}:{{ marti_port }}"
    volumes:
      - ./config.json:/app/config.json:ro
      - ./keys:/app/keys:ro
    environment:
      - DB_PASSWORD=${DB_PASSWORD}
    depends_on:
      postgres:
        condition: service_healthy
      # A roll fails without its email, and postfix takes a few seconds to
      # start listening after the container does.
      postfix:
        condition: service_healthy
    # /health answers only after a database query. node:22-slim has no curl, so
    # probe with node's fetch. deploy-marti.sh waits on this to decide rollback.
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:{{ marti_port }}/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    restart: unless-stopped
    logging:
      driver: journald
      options:
        tag: marti
  postgres:
    image: postgres:16
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: dicedb
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    logging:
      driver: journald
      options:
        tag: marti-postgres
  postfix:
    # Pinned: the healthcheck below calls the image's /scripts/healthcheck.sh,
    # so an unreviewed upgrade could leave postfix unhealthy and block app start.
    image: boky/postfix:v5.1.0
    environment:
      - ALLOWED_SENDER_DOMAINS={{ marti_hostname }}
      - POSTFIX_myhostname={{ marti_hostname }}
      - DKIM_AUTOGENERATE=yes
    volumes:
      - dkim_keys:/etc/opendkim/keys
    # The image's own check: EHLO on the submission port plus the DKIM milter
    # socket. Its Dockerfile declares it, but the published image carries no
    # healthcheck metadata, so 'service_healthy' needs it spelled out here.
    healthcheck:
      test: ["CMD", "/scripts/healthcheck.sh"]
      interval: 5s
      timeout: 10s
      retries: 6
      start_period: 30s
    restart: unless-stopped
    logging:
      driver: journald
      options:
        tag: marti-postfix
volumes:
  pgdata:
  dkim_keys:
