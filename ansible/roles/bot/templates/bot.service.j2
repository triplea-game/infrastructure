[Unit]
Description=TripleA Bot %i
Documentation=
# The bot exits after every game by design (EXIT_ON_GAME_END=true), so restarts are
# routine; disable systemd's default 5-starts-in-10s limit so a fast-exiting bot —
# eg one that keeps exiting because the lobby is unreachable — keeps retrying instead
# of being parked in the failed state until a hand-restart.
StartLimitIntervalSec=0

[Service]
User=bot
Group=bot
# --memory caps each bot at its container cgroup, so a runaway bot is killed by the
# container's cgroup limit and restarted alone (Restart=always) rather than the
# host-wide OOM-killer wedging the whole 1GB host; --memory-swap lets it spill to
# the swapfile before that.
ExecStart=docker run \
   --rm \
   --network host \
   --memory={{ bot_container_memory }} \
   --memory-swap={{ bot_container_memory_swap }} \
   --pull missing \
   --env BOT_PORT_NUMBER=40%i \
   --env LOBBY_URI=https://prod.triplea-game.org \
   --env BOT_NAME=Bot_{{  bot_number }}%i_{{ bot_location }} \
   --env EXIT_ON_GAME_END=true \
   --env BOT_MAX_MEMORY={{ bot_max_memory }} \
   --env MAPS_FOLDER=/downloadedMaps \
   --env BOT_COMMENT="Official Host" \
   -v {{ bot_maps_folder }}:/downloadedMaps \
   -v /home/bot/triplea/savedGames/autoSave:/home/bot/triplea/savedGames/autoSave \
   --name bot%i \
   ghcr.io/triplea-game/bot:latest
ExecStop=docker stop bot%i
Restart=always
# Back off between restarts so a crash-looping bot does not saturate the host.
RestartSec=15
SyslogIdentifier=bot%i

[Install]
WantedBy=multi-user.target
