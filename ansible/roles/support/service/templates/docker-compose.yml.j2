# Log to the host journald under a stable tag per service. The default
# json-file driver keeps only the current container's logs, so a redeploy or
# restart loses all history; journald persists on the host across container
# recreation, and the tag makes each service readable with `journalctl -t <tag>`
# (how pull-logs.sh reads them). Matches the forums role, also on journald.
services:
  service:
    image: {{ support_image }}
    ports:
      # Publish on loopback only; the support/public_nginx vhost on this host
      # terminates TLS and proxies here, so the app is never exposed on an
      # external interface.
      - "127.0.0.1:8010:8010"
    environment:
      - HTTP_PORT=8010
      - DB_URL=postgres18:5432/{{ database_name }}
      - DATABASE_USER={{ database_user }}
      - DATABASE_PASSWORD=${DB_PASSWORD}
      - GITHUB_API_TOKEN=${GITHUB_API_TOKEN}
      - MAP_INDEXING_ENABLED=true
      - MAP_INDEXING_PERIOD_MINUTES=60
    depends_on:
      postgres18:
        condition: service_healthy
    # Probes readiness with bash's /dev/tcp so lobby and support share one
    # check; support's eclipse-temurin JRE image ships neither curl nor wget.
    # start_period is twice marti's because the JVM starts slower and Flyway
    # migrates before the app serves.
    # deploy-support.sh waits on this to decide rollback.
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/8010 && printf 'GET /q/health/ready HTTP/1.0\\r\\n\\r\\n' >&3 && head -1 <&3 | grep -q ' 200 '"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 60s
    restart: unless-stopped
    logging:
      driver: journald
      options:
        tag: support
  postgres18:
    image: postgres:18
    environment:
      POSTGRES_USER: {{ database_user }}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: {{ database_name }}
    volumes:
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ database_user }} -d {{ database_name }}"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    logging:
      driver: journald
      options:
        tag: support-postgres
volumes:
  pgdata:
