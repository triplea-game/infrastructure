[Unit]
Description=TripleA oauth2-proxy (support-server GitHub auth gate)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=oauth2-proxy
Group=oauth2-proxy
WorkingDirectory={{ oauth2_proxy_working_directory }}
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
