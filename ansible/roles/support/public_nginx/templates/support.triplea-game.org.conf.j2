# Support server vhost, post-certbot: the '# managed by Certbot' lines are
# folded back from the live host so Ansible runs don't strip the cert config.
# On a fresh host the cert doesn't exist yet; see this role's README for the
# certbot phases.
#
# The support app trusts the X-Auth-Email / X-Auth-Groups headers set by lobby's
# nginx; those arrive on the request and are passed straight through to the app.
# The firewall (this role) is what keeps lobby the only caller — do not add auth
# here that would let other callers reach the app.
server {
    server_name {{ support_hostname }};

    location / {
        proxy_pass http://127.0.0.1:{{ support_app_port }};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/{{ support_hostname }}/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/{{ support_hostname }}/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = {{ support_hostname }}) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name {{ support_hostname }};
    return 404; # managed by Certbot
}
