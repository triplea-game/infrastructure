# HTTP-only phase-1 vhost for the support server (see this role's README for the
# certbot phases). Once a cert is issued, certbot rewrites this to listen on 443
# and redirect 80 -> 443; mirror those '# managed by Certbot' additions back into
# this template so future Ansible runs stay idempotent.
#
# The support app trusts the X-Auth-Email / X-Auth-Groups headers set by lobby's
# nginx; those arrive on the request and are passed straight through to the app.
# The firewall (this role) is what keeps lobby the only caller — do not add auth
# here that would let other callers reach the app.
server {
    listen 80;
    listen [::]:80;
    server_name {{ support_hostname }};

    location / {
        proxy_pass http://127.0.0.1:{{ support_app_port }};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90;
    }
}
