services:
  postgres:
    image: postgres:18
    restart: unless-stopped
    environment:
      POSTGRES_USER: nodebb
      POSTGRES_PASSWORD: "{{ nodebb_postgres_password }}"
      POSTGRES_DB: nodebb
    volumes:
      # postgres:18 moved PGDATA under this mount point; the data lives in a
      # subdirectory. Mounting at /var/lib/postgresql/data (the pre-18 path)
      # aborts startup. Matches the lobby/support roles, also on postgres:18.
      - postgres_data:/var/lib/postgresql
    networks:
      - forums_internal
    logging:
      driver: journald
      options:
        tag: forums-postgres

  nodebb:
    image: ghcr.io/triplea-game/forums/nodebb:latest
    restart: unless-stopped
    user: "1001:1001"
    ports:
      # Bind only to localhost so nginx (running on the host) can proxy to
      # port 4567, but the port is not reachable from outside the server.
      - "127.0.0.1:4567:4567"
    volumes:
      - {{ forums_working_directory }}/config.json:/opt/config/config.json
      - {{ forums_working_directory }}/uploads:/usr/src/app/public/uploads
    depends_on:
      - postgres
    networks:
      - forums_internal
    logging:
      driver: journald
      options:
        tag: forums-nodebb

volumes:
  postgres_data:

networks:
  forums_internal:

