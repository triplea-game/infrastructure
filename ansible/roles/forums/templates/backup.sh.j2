#!/bin/bash

set -euo pipefail

# The dump carries password hashes, emails and the session store, and it sits
# in a world-readable directory until rsync ships it — keep it owner-only.
umask 077

BACKUP_DIR="{{ forums_working_directory }}"
# The lobby host's prune matches this name by the glob on the 'forums'
# lobby/backup_target instance in playbook.yml, and relies on the timestamp
# sorting newest-first; change both together.
BACKUP_FILE="triplea_forums_db_backup_$(date +%Y%m%d-%H%M%S).sql.gz"

# A failed rsync exits (set -e) before the rm below and strands its dump, so
# clear leftovers here; the +60min floor avoids racing a concurrent run's dump.
# Retention of shipped copies lives on the lobby host (lobby/backup_target).
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'triplea_forums_db_backup_*.sql.gz' \
  -mmin +60 -delete

docker compose -f "{{ nodebb_docker_compose_path }}" exec -T postgres \
  pg_dump -U nodebb -d nodebb | gzip > "$BACKUP_DIR/$BACKUP_FILE"
# The remote path below is anchored at the root of the 'rrsync -wo' jail the
# lobby host pins this key to, not at /, so ':/' means the backup directory the
# lobby/backup_target role owns. rrsync rejects a path containing '..'.
rsync -az -e "ssh -i {{ backup_ssh_key_path }} -o StrictHostKeyChecking=accept-new" \
  "$BACKUP_DIR/$BACKUP_FILE" \
  forums-backup@prod.triplea-game.org:/
rm -f "$BACKUP_DIR/$BACKUP_FILE"
