# Managed by Ansible (forums role) - do not edit on the host.

ssl_session_cache shared:ssl_session_cache:10m;

# Per-IP brake on the credential endpoints. NodeBB locks an account after
# repeated failures; this is what slows stuffing spread across many accounts.
limit_req_zone $binary_remote_addr zone=forums_login:10m rate={{ forums_login_rate }};

server {
    listen 80;
    listen [::]:80;
    server_name {{ forums_hostname }};
    return 301 https://{{ forums_hostname }}$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ forums_hostname }};
    server_tokens off;

    # Issued by hand with certbot; renewal is certbot's, not Ansible's.
    ssl_certificate /etc/letsencrypt/live/{{ forums_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ forums_hostname }}/privkey.pem;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Mozilla "intermediate" set; the dhparam file is generated by hand.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_dhparam {{ forums_dhparam_path }};

    # Port 80 already redirects everything, so pinning browsers to https costs
    # nothing and closes the downgrade path.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # ACME http-01 webroot for certbot renewals.
    location /.well-known {
        alias /var/www/nodebb/.well-known;
    }

    # Friendlier page while NodeBB is restarting.
    error_page 502 /502.html;
    location /502.html {
        alias /var/www/nodebb/502.html;
    }

    location = /login {
        limit_req zone=forums_login burst={{ forums_login_burst }} nodelay;
        limit_req_status 429;
        include /etc/nginx/include/forums-proxy.conf;
    }

    location = /register {
        limit_req zone=forums_login burst={{ forums_login_burst }} nodelay;
        limit_req_status 429;
        include /etc/nginx/include/forums-proxy.conf;
    }

    location = /api/v3/utilities/login {
        limit_req zone=forums_login burst={{ forums_login_burst }} nodelay;
        limit_req_status 429;
        include /etc/nginx/include/forums-proxy.conf;
    }

    location / {
        include /etc/nginx/include/forums-proxy.conf;
    }
}
