# Managed by Ansible (forums role) - do not edit on the host.

ssl_session_cache shared:ssl_session_cache:10m;

# 'combined' with fields appended, never inserted: log parsers count fields
# from the front. urt is quoted because a retried request logs "a, b".
log_format forums '$remote_addr - $remote_user [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                  'rt=$request_time urt="$upstream_response_time" '
                  'cache=$upstream_cache_status limit_req=$limit_req_status '
                  'conn=$connection conn_reqs=$connection_requests';

# Per-client key for the per-IP limits: IPv4 as-is, IPv6 cut to its /64, since
# one client usually holds a whole /64 and could otherwise rotate through it.
# An address compressed ('::') within its first four groups falls back to the
# full address.
map $remote_addr $forums_client {
    "~^(?<v6net>[0-9a-f]+:[0-9a-f]+:[0-9a-f]+:[0-9a-f]+):" $v6net;
    default $remote_addr;
}

# Per-IP brake on the credential endpoints. NodeBB locks an account after
# repeated failures; this is what slows stuffing spread across many accounts.
limit_req_zone $forums_client zone=forums_login:10m rate={{ forums_login_rate }};

# Per-IP brake on pages, websockets and uploads: stops one client from using
# up the site-wide caps below and locking everyone out.
limit_req_zone $forums_client zone=forums_client_rate:10m rate={{ forums_client_rate }};
limit_req_zone $forums_client zone=forums_socket_rate:10m rate={{ forums_client_rate }};
limit_req_zone $forums_client zone=forums_uploads_rate:10m rate={{ forums_uploads_rate }};

# Connection caps on websockets and uploads, which sit outside the render cap
# but still hold nginx connections and NodeBB work for their whole lifetime.
limit_conn_zone $forums_client zone=forums_socket_client_conn:10m;
limit_conn_zone $server_name zone=forums_socket_conn:1m;
limit_conn_zone $server_name zone=forums_uploads_conn:1m;

# Site-wide (not per-IP) brake on page and API renders. Scrapers rotating
# through proxy pools stay under any per-IP limit a reader would tolerate, so
# this caps the work NodeBB and Postgres take on regardless of who sends it:
# a short queue absorbs spikes, the rest get a fast 503 instead of a 60s hang.
limit_req_zone $server_name zone=forums_render_rate:1m rate={{ forums_render_rate }};
limit_conn_zone $server_name zone=forums_render_conn:1m;

# NodeBB's session middleware runs ahead of /assets, so every asset request
# carrying a cookie rewrites that session's row in Postgres. Asset URLs are
# cache-busted, so nginx can serve them without NodeBB or the cookie.
proxy_cache_path {{ forums_assets_cache_path }} levels=1:2 keys_zone=forums_assets:10m
                 max_size={{ forums_assets_cache_max_size }} inactive=7d use_temp_path=off;

server {
    listen 80;
    listen [::]:80;
    server_name {{ forums_hostname }};
    return 301 https://{{ forums_hostname }}$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ forums_hostname }};
    server_tokens off;
    keepalive_timeout {{ forums_keepalive_timeout }};
    access_log /var/log/nginx/access.log forums;

    # Issued by hand with certbot; renewal is certbot's, not Ansible's.
    ssl_certificate /etc/letsencrypt/live/{{ forums_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ forums_hostname }}/privkey.pem;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Mozilla "intermediate" set; the dhparam file is generated by hand.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_dhparam {{ forums_dhparam_path }};

    # Port 80 already redirects everything, so pinning browsers to https costs
    # nothing and closes the downgrade path.
    add_header Strict-Transport-Security "max-age=31536000" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1000;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    # ACME http-01 webroot for certbot renewals.
    location /.well-known {
        alias /var/www/nodebb/.well-known;
    }

    # Friendlier page while NodeBB is restarting. Both error_page lines sit at
    # server level because a location that sets any error_page inherits none.
    error_page 502 /502.html;
    error_page 503 /forums-busy.html;
    location /502.html {
        alias /var/www/nodebb/502.html;
    }

    location = /login {
        limit_req zone=forums_login burst={{ forums_login_burst }} nodelay;
        limit_req_status 429;
        include /etc/nginx/include/forums-proxy.conf;
    }

    location = /register {
        limit_req zone=forums_login burst={{ forums_login_burst }} nodelay;
        limit_req_status 429;
        include /etc/nginx/include/forums-proxy.conf;
    }

    location = /api/v3/utilities/login {
        limit_req zone=forums_login burst={{ forums_login_burst }} nodelay;
        limit_req_status 429;
        include /etc/nginx/include/forums-proxy.conf;
    }

    # Uploads stay uncached and keep the cookie: with NodeBB's private uploads
    # on, a cached or cookieless request would lock members out of them.
    location ^~ /assets/uploads/ {
        limit_req zone=forums_uploads_rate burst={{ forums_uploads_burst }} nodelay;
        limit_conn forums_uploads_conn {{ forums_uploads_max_conn }};
        # 429, not 503: the "Forums busy" page is no use to an image or download.
        limit_req_status 429;
        limit_conn_status 429;
        include /etc/nginx/include/forums-proxy.conf;
    }

    location ^~ /assets/ {
        proxy_cache forums_assets;
        proxy_cache_valid 200 {{ forums_assets_cache_ttl }};
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_hide_header Set-Cookie;
        # Any add_header here drops the server-level ones, so HSTS is restated.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Cache-Status $upstream_cache_status;
        include /etc/nginx/include/forums-proxy.conf;
        proxy_set_header Cookie "";
    }

    # Websockets hold a connection for as long as a tab is open, so they would
    # starve the render cap below. NodeBB still serves post and topic content
    # to guests over socket.io, so it gets its own per-IP limit instead.
    location ^~ /socket.io/ {
        limit_req zone=forums_socket_rate burst={{ forums_client_burst }} nodelay;
        limit_conn forums_socket_client_conn {{ forums_socket_client_max_conn }};
        limit_conn forums_socket_conn {{ forums_socket_max_conn }};
        limit_req_status 429;
        limit_conn_status 429;
        include /etc/nginx/include/forums-proxy.conf;
    }

    # NodeBB's health probe, which the forums CI smoke test polls. Under the
    # site-wide render cap, scraper load would fail the smoke test with the
    # forums healthy, so only the per-IP limit applies.
    location = /sping {
        limit_req zone=forums_client_rate burst={{ forums_client_burst }} nodelay;
        include /etc/nginx/include/forums-proxy.conf;
    }

    location / {
        # nginx stops at the first limit that rejects, so the per-IP limit goes
        # first: a flooding client is turned away before it spends site-wide
        # budget. Both reject with the 503 "Forums busy" page; error.log names
        # the zone that fired.
        limit_req zone=forums_client_rate burst={{ forums_client_burst }} nodelay;
        limit_req zone=forums_render_rate burst={{ forums_render_burst }};
        limit_conn forums_render_conn {{ forums_render_max_conn }};
        # A stuck render holds one of the render_max_conn slots, and past 30s no
        # reader is still waiting for it.
        proxy_read_timeout 30s;
        include /etc/nginx/include/forums-proxy.conf;
    }

    location = /forums-busy.html {
        internal;
        default_type text/html;
        add_header Retry-After 10 always;
        return 503 '<!doctype html><title>Forums busy</title><p>The forums are under heavy load. Please try again in a few seconds.</p>';
    }
}
